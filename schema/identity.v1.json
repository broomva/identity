{
  "$defs": {
    "Attestation": {
      "$defs": {
        "NodeId": {
          "description": "Tailscale stable node id. One to sixty-four ASCII alphanumeric bytes.",
          "type": "string"
        },
        "SessionRef": {
          "additionalProperties": true,
          "description": "One running session: surface, harness, node and a surface-local id.\n\nThe display form is `{surface}:{harness}@{node}/{id}`. It does not carry unknown keys. JSON does.",
          "properties": {
            "harness": {
              "anyOf": [
                {
                  "enum": [
                    "claude-code",
                    "codex",
                    "gemini",
                    "agy"
                  ]
                },
                {
                  "type": "string"
                }
              ],
              "description": "A lowercase wire token. The crate also rejects a doubled hyphen.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "node": {
              "$ref": "#/$defs/NodeId"
            },
            "surface": {
              "anyOf": [
                {
                  "enum": [
                    "paseo",
                    "t3",
                    "direct"
                  ]
                },
                {
                  "type": "string"
                }
              ],
              "description": "A lowercase wire token. The crate also rejects a doubled hyphen.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            }
          },
          "required": [
            "surface",
            "harness",
            "node",
            "id"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "description": "A claim that a session may act within a scope on a node until it expires.\n\nThe lifetime is greater than zero and at most one hour. Renewal is a new value.\nThe bound node equals the session node.",
      "properties": {
        "expires_at": {
          "format": "int64",
          "type": "integer"
        },
        "issued_at": {
          "format": "int64",
          "type": "integer"
        },
        "node": {
          "$ref": "#/$defs/NodeId"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session": {
          "$ref": "#/$defs/SessionRef"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "session",
        "node",
        "scope",
        "issued_at",
        "expires_at"
      ],
      "title": "Attestation",
      "type": "object"
    },
    "EndReason": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "enum": [
            "completed",
            "revoked",
            "expired"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "A lowercase wire token. The crate also rejects a doubled hyphen.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "EndReason",
      "type": "string"
    },
    "HarnessId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
