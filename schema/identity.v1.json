{
  "$defs": {
    "Attestation": {
      "$defs": {
        "NodeId": {
          "description": "Tailscale stable node id. One to sixty-four ASCII alphanumeric bytes.",
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "pattern": "\\n"
          },
          "pattern": "^[A-Za-z0-9]{1,64}$",
          "type": "string"
        },
        "SessionRef": {
          "additionalProperties": {
            "$ref": "#/$defs/ExtraValue1"
          },
          "description": "One running session: surface, harness, node and a surface-local id.\n\nThe display form is `{surface}:{harness}@{node}/{id}`. It does not carry unknown keys. JSON does.",
          "properties": {
            "harness": {
              "allOf": [
                {
                  "not": {
                    "pattern": "--"
                  }
                },
                {
                  "not": {
                    "pattern": "\\n"
                  }
                }
              ],
              "anyOf": [
                {
                  "enum": [
                    "claude-code",
                    "codex",
                    "gemini",
                    "agy"
                  ]
                },
                {
                  "type": "string"
                }
              ],
              "description": "A lowercase wire token. The crate also rejects a doubled hyphen.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            "id": {
              "description": "One to 256 characters, with no whitespace or controls. maxLength counts Unicode code points. The crate counts bytes.",
              "maxLength": 256,
              "minLength": 1,
              "not": {
                "pattern": "\\n"
              },
              "pattern": "^[^\u0000- -   -     　]+$",
              "type": "string"
            },
            "node": {
              "$ref": "#/$defs/NodeId"
            },
            "surface": {
              "allOf": [
                {
                  "not": {
                    "pattern": "--"
                  }
                },
                {
                  "not": {
                    "pattern": "\\n"
                  }
                }
              ],
              "anyOf": [
                {
                  "enum": [
                    "paseo",
                    "t3",
                    "direct"
                  ]
                },
                {
                  "type": "string"
                }
              ],
              "description": "A lowercase wire token. The crate also rejects a doubled hyphen.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            }
          },
          "required": [
            "surface",
            "harness",
            "node",
            "id"
          ],
          "type": "object"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/ExtraValue1"
      },
      "description": "A claim that a session may act within a scope on a node until it expires.\n\nThe lifetime is greater than zero and at most one hour. Renewal is a new value.\nThe bound node equals the session node.",
      "properties": {
        "expires_at": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "issued_at": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "node": {
          "$ref": "#/$defs/NodeId"
        },
        "scope": {
          "items": {
            "allOf": [
              {
                "not": {
                  "pattern": "\\.\\."
                }
              },
              {
                "not": {
                  "pattern": "\\n"
                }
              }
            ],
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "session": {
          "$ref": "#/$defs/SessionRef"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "session",
        "node",
        "scope",
        "issued_at",
        "expires_at"
      ],
      "title": "Attestation",
      "type": "object"
    },
    "EndReason": {
      "allOf": [
        {
          "not": {
            "pattern": "--"
          }
        },
        {
          "not": {
            "pattern": "\\n"
          }
        }
      ],
      "anyOf": [
        {
          "enum": [
            "completed",
            "revoked",
            "expired"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "A lowercase wire token. The crate also rejects a doubled hyphen.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "EndReason",
      "type": "string"
    },
