            "agy"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "A lowercase wire token. The crate also rejects a doubled hyphen.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "HarnessId",
      "type": "string"
    },
    "NodeId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Tailscale stable node id. One to sixty-four ASCII alphanumeric bytes.",
      "title": "NodeId",
      "type": "string"
    },
    "Principal": {
      "$defs": {
        "NodeId": {
          "description": "Tailscale stable node id. One to sixty-four ASCII alphanumeric bytes.",
          "type": "string"
        },
        "SessionRef": {
          "additionalProperties": true,
          "description": "One running session: surface, harness, node and a surface-local id.\n\nThe display form is `{surface}:{harness}@{node}/{id}`. It does not carry unknown keys. JSON does.",
          "properties": {
            "harness": {
              "anyOf": [
                {
                  "enum": [
                    "claude-code",
                    "codex",
                    "gemini",
                    "agy"
                  ]
                },
                {
                  "type": "string"
                }
              ],
              "description": "A lowercase wire token. The crate also rejects a doubled hyphen.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "node": {
              "$ref": "#/$defs/NodeId"
            },
            "surface": {
              "anyOf": [
                {
                  "enum": [
                    "paseo",
                    "t3",
                    "direct"
                  ]
                },
                {
                  "type": "string"
                }
              ],
              "description": "A lowercase wire token. The crate also rejects a doubled hyphen.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            }
          },
          "required": [
            "surface",
            "harness",
            "node",
            "id"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Who is calling. Six closed kinds: owner, owner_device, agent, runner_job, service, unverified. The kind field is not proof.",
      "oneOf": [
        {
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "owner",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "owner_device",
              "type": "string"
            },
            "node": {
              "$ref": "#/$defs/NodeId"
            }
          },
          "required": [
            "kind",
            "node"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "agent",
              "type": "string"
            },
            "session": {
              "$ref": "#/$defs/SessionRef"
            }
          },
          "required": [
            "kind",
            "session"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "runner_job",
              "type": "string"
            },
            "node": {
              "$ref": "#/$defs/NodeId"
            }
          },
          "required": [
            "kind",
            "id",
            "node"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "service",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "unverified",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ],
      "title": "Principal"
    },
    "SessionEnd": {
      "$defs": {
        "NodeId": {
          "description": "Tailscale stable node id. One to sixty-four ASCII alphanumeric bytes.",
          "type": "string"
