            "harness",
            "node",
            "id"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "description": "A session has ended. This is a record, not a signature.",
      "properties": {
        "ended_at": {
          "format": "int64",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "revoked",
                "expired"
              ]
            },
            {
              "type": "string"
            }
          ],
          "description": "A lowercase wire token. The crate also rejects a doubled hyphen.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/SessionRef"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "session",
        "ended_at",
        "reason"
      ],
      "title": "SessionEnd",
      "type": "object"
    },
    "SessionKey": {
      "$defs": {
