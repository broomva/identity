      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "description": "The public half of a node-bound session key. The secret never enters this type.\n\nThe lifetime rule is the same one-hour rule as an attestation.",
      "properties": {
        "expires_at": {
          "format": "int64",
          "type": "integer"
